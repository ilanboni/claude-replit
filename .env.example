# ─── DATABASE ─────────────────────────────────────────────────────────
# Supabase Session pooler URI (NON Direct connection)
# Project ref: fzhbrqbihgbsmxnimefr
# Reset password se contiene caratteri speciali (@ : / ?)
DATABASE_URL=postgresql://postgres.fzhbrqbihgbsmxnimefr:PASSWORD@aws-0-XXX.pooler.supabase.com:5432/postgres

# ─── SESSION ──────────────────────────────────────────────────────────
# Random 64 char. Generabile con: openssl rand -base64 48
SESSION_SECRET=

# ─── GOOGLE OAUTH (per Google SSO login) ──────────────────────────────
# Crea su https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID → Web application
# Authorized redirect URIs: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Whitelist email autorizzate al login (comma-separated, opzionale).
# Se vuoto, qualunque utente Google può loggarsi (con role=viewer di default).
# Es: ALLOWED_EMAILS=ilanboni@gmail.com,collaboratore@example.com
ALLOWED_EMAILS=ilanboni@gmail.com

# ─── DEPLOY ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── ESISTENTI (Paolo / integrations) ─────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ULTRAMSG_TOKEN=
# ULTRAMSG_INSTANCE_ID=
